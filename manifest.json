{
  "id": "watchlist",
  "name": "Family Watchlist",
  "version": "1.0.0",
  "description": "A shared list of movies and shows the household wants to watch together. Add titles, mark them watched with a rating, filter by genre or mood, or tap Surprise Me for a random pick.",
  "entrypoint": "index.html",
  "runtime": "static",
  "icon": "🍿",
  "category": "entertainment",
  "tags": ["movies", "shows", "watchlist", "entertainment", "family"],
  "storage": "db",
  "automation_actions": {
    "add_title": {
      "title": "Add a title to the watchlist",
      "description": "Queue up a movie or show when another app's event fires - a recommendation posted to the forum, a reward earned, a trip planned.",
      "params": {
        "added_by_id": { "type": "member", "label": "Added by", "required": true },
        "title": { "type": "text", "label": "Title", "required": true },
        "kind": { "type": "text", "label": "Movie or show", "default": "movie", "options": ["movie", "show"] },
        "genre": { "type": "text", "label": "Genre", "default": "" },
        "note": { "type": "text", "label": "Note", "default": "" }
      },
      "dedupe": { "table": "titles", "column": "source_event_id" },
      "steps": [
        {
          "op": "insert",
          "table": "titles",
          "values": {
            "id": "$uuid",
            "title": ":title",
            "kind": ":kind",
            "genre": ":genre",
            "note": ":note",
            "status": "unwatched",
            "added_by_id": ":added_by_id",
            "added_by_name": "Automation",
            "created_at": "$now",
            "source_event_id": "$event_id"
          }
        }
      ]
    }
  },
  "publishes": ["watchlist.title_added", "watchlist.title_watched"],
  "publish_acls": {
    "watchlist.title_added": { "require_role": "member" },
    "watchlist.title_watched": { "require_role": "member" }
  },
  "contexts": ["household", "shared_space"],
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "member_references": {
    "titles": {
      "column": "added_by_id",
      "on_removed": "keep"
    }
  },
  "retention": {
    "titles": {
      "default": 730,
      "timestamp_column": "created_at",
      "override_key": "watched_titles",
      "exempt_when": {
        "column": "status",
        "values": ["unwatched"]
      }
    }
  },
  "nav": { "label": "Watchlist" },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COUNT(*) AS n FROM app_watchlist__titles WHERE status = 'unwatched' LIMIT 1"
    },
    "display": { "template": "badge", "count": "n", "label": "to watch", "severity": "info" }
  },
  "resource_limits": {
    "max_db_bytes": 10485760
  },
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["unwatched_titles", "watched_ratings"]
  }
}
